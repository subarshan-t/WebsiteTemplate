---
import { nav, site } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="header" data-header>
  <div class="container header__inner">
    <a href="/" class="logo" aria-label={`${site.name} home`}>
      <span class="logo__dot"></span>{site.name}
    </a>

    <nav class="header__nav" aria-label="Primary">
      {nav.map((item) => (
        <a href={item.href} class:list={['link', { active: isActive(item.href) }]}>{item.label}</a>
      ))}
    </nav>

    <div class="header__actions">
      <button class="icon-btn" data-theme-toggle aria-label="Toggle colour theme">
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
      </button>
      <a href="/contact" class="btn btn--solid header__cta">Let’s talk</a>
      <button class="burger" data-menu-toggle aria-expanded="false" aria-controls="menu" aria-label="Menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="menu" data-menu>
  <div class="container menu__inner">
    <nav class="menu__nav" aria-label="Mobile">
      {nav.map((item, i) => (
        <a href={item.href} class="menu__link">
          <span data-menu-link><sup>0{i + 1}</sup>{item.label}</span>
        </a>
      ))}
    </nav>
    <div class="menu__info">
      <a href={`mailto:${site.email}`} class="link">{site.email}</a>
      <div class="menu__socials">
        {site.socials.map((s) => <a href={s.href} class="link">{s.label}</a>)}
      </div>
    </div>
  </div>
</div>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    padding: 24px 0;
    transition: transform 0.5s cubic-bezier(0.7, 0, 0.2, 1), padding 0.4s ease, background 0.4s ease;
  }
  .header:global(.is-scrolled) {
    padding: 14px 0;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .header:global(.is-hidden) {
    transform: translateY(-100%);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 28px;
    letter-spacing: -0.05em;
    text-transform: lowercase;
    position: relative;
    z-index: 102;
  }
  .logo__dot {
    width: 18px;
    height: 18px;
    border-radius: 4px 50% 50% 50%;
    background: var(--accent);
  }
  .header__nav {
    display: flex;
    gap: 36px;
    font-size: 15px;
    font-weight: 500;
  }
  .header__nav a.active {
    color: var(--accent);
  }
  .header__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    position: relative;
    z-index: 102;
  }
  .icon-btn {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: none;
    color: var(--fg);
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .icon-btn svg {
    width: 18px;
  }
  .i-moon {
    display: none;
  }
  :global([data-theme='light']) .i-sun {
    display: none;
  }
  :global([data-theme='light']) .i-moon {
    display: block;
  }
  .header__cta {
    padding: 12px 22px;
  }
  .burger {
    display: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: none;
    cursor: pointer;
    place-content: center;
    gap: 6px;
  }
  .burger span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--fg);
    transition: transform 0.4s ease;
  }
  .burger[aria-expanded='true'] span:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .burger[aria-expanded='true'] span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 101;
    background: var(--bg-soft);
    visibility: hidden;
    clip-path: circle(0% at 100% 0%);
  }
  .menu__inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: 120px;
    padding-bottom: 40px;
  }
  .menu__nav {
    display: grid;
  }
  .menu__link {
    display: block;
    overflow: hidden;
    font-family: var(--font-condensed);
    font-size: clamp(52px, 12vw, 110px);
    line-height: 1;
    text-transform: uppercase;
  }
  .menu__link span {
    display: inline-block;
  }
  .menu__link sup {
    font-size: 14px;
    color: var(--accent);
    margin-right: 10px;
    vertical-align: top;
  }
  .menu__link:hover {
    color: var(--accent);
  }
  .menu__info {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    color: var(--muted);
  }
  .menu__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  @media (max-width: 1024px) {
    .header__nav,
    .header__cta {
      display: none;
    }
    .burger {
      display: grid;
    }
  }
</style>
