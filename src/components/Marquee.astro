---
interface Props {
  items: string[];
  reverse?: boolean;
  speed?: string;
  size?: 'lg' | 'sm';
}
const { items, reverse = false, speed = '30s', size = 'lg' } = Astro.props;
---
<div class:list={['marquee', `marquee--${size}`, { 'marquee--reverse': reverse }]} style={`--speed:${speed}`} aria-hidden="true">
  {[0, 1].map(() => (
    <div class="marquee__track">
      {items.map((item) => (
        <span class="marquee__item">
          {item}
          <svg class="marquee__star" viewBox="0 0 24 24"><path fill="currentColor" d="M12 0l2.9 9.1L24 12l-9.1 2.9L12 24l-2.9-9.1L0 12l9.1-2.9z" /></svg>
        </span>
      ))}
    </div>
  ))}
</div>

<style>
  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: clamp(20px, 3vw, 48px);
    padding-right: clamp(20px, 3vw, 48px);
    font-family: var(--font-condensed);
    font-weight: 400;
    text-transform: uppercase;
  }
  .marquee--lg .marquee__item {
    font-size: clamp(48px, 9vw, 140px);
    line-height: 1.1;
  }
  .marquee--sm .marquee__item {
    font-size: clamp(22px, 3vw, 40px);
    color: var(--muted);
  }
  .marquee__star {
    width: 0.5em;
    height: 0.5em;
    color: var(--accent);
  }
</style>
