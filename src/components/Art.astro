---
// Generative placeholder artwork so the template ships without stock photos.
// Swap for <Image /> once you have real media.
interface Props {
  hue: number;
  label?: string;
  variant?: number;
  class?: string;
  parallax?: boolean;
}
const { hue, label, variant = 0, class: cls = '', parallax = false } = Astro.props;
const h2 = (hue + 40) % 360;
const h3 = (hue + 320) % 360;
const shapes = [
  `<circle cx="70%" cy="40%" r="28%" fill="hsl(${h2} 90% 60% / .85)"/><rect x="12%" y="55%" width="38%" height="30%" rx="40" fill="hsl(${h3} 80% 55% / .7)"/>`,
  `<rect x="20%" y="18%" width="60%" height="64%" rx="300" fill="hsl(${h2} 85% 60% / .8)"/><circle cx="30%" cy="70%" r="14%" fill="hsl(${h3} 90% 65% / .8)"/>`,
  `<ellipse cx="50%" cy="50%" rx="34%" ry="22%" fill="none" stroke="hsl(${h2} 90% 65% / .9)" stroke-width="18"/><circle cx="50%" cy="50%" r="10%" fill="hsl(${h3} 90% 60%)"/>`,
];
const shape = shapes[variant % shapes.length];
---
<div class:list={['art', cls]} role="img" aria-label={label ?? 'Project artwork'}>
  <div class="art__inner" data-parallax={parallax ? '8' : undefined}>
    <svg width="100%" height="100%">
      <defs>
        <radialGradient id={`g-${hue}-${variant}`} cx="30%" cy="20%" r="100%">
          <stop offset="0%" stop-color={`hsl(${hue} 90% 58%)`} />
          <stop offset="100%" stop-color={`hsl(${hue} 70% 18%)`} />
        </radialGradient>
      </defs>
      <rect width="100%" height="100%" fill={`url(#g-${hue}-${variant})`} />
      <Fragment set:html={shape} />
    </svg>
    <div class="art__grain"></div>
  </div>
</div>

<style>
  .art {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-soft);
    aspect-ratio: var(--ratio, 4 / 5);
  }
  .art__inner {
    position: absolute;
    inset: -12% 0;
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .art__inner svg {
    width: 100%;
    height: 100%;
  }
  .art__grain {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    mix-blend-mode: overlay;
    background-image: radial-gradient(rgba(255, 255, 255, 0.6) 1px, transparent 1px);
    background-size: 3px 3px;
  }
</style>
