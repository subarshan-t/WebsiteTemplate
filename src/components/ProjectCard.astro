---
import type { Project } from '../data/site';
import Art from './Art.astro';
interface Props {
  project: Project;
  index?: number;
  ratio?: string;
}
const { project, index = 0, ratio = '4 / 5' } = Astro.props;
---
<a href={`/portfolio/${project.slug}`} class="card" data-cursor="View" data-reveal style={`--ratio:${ratio}`}>
  <Art hue={project.hue} variant={index} label={project.title} parallax />
  <div class="card__meta">
    <div>
      <h3 class="card__title">{project.title}</h3>
      <p class="card__cat">{project.category}</p>
    </div>
    <span class="card__year">{project.year}</span>
  </div>
</a>

<style>
  .card {
    display: grid;
    gap: 20px;
  }
  .card :global(.art__inner) {
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.6s ease;
  }
  .card:hover :global(.art__inner svg) {
    transform: scale(1.06);
  }
  .card :global(.art__inner svg) {
    transition: transform 1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card__meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }
  .card__title {
    font-size: clamp(22px, 2.4vw, 32px);
  }
  .card__cat,
  .card__year {
    color: var(--muted);
    font-size: 15px;
  }
  .card__year {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 14px;
  }
</style>
