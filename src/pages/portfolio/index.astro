---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/site';
const categories = ['All', ...new Set(projects.map((p) => p.category))];
---
<Base title="Portfolio" description="Selected branding, product and web projects by Redox.">
  <PageHero eyebrow="Portfolio" title="Selected<br /><em class='accent'>works</em>" lead="Brands, products and websites we’ve had the pleasure of building." />

  <section class="section">
    <div class="container">
      <div class="filters" role="group" aria-label="Filter projects">
        {categories.map((c, i) => (
          <button class:list={['filter', { 'is-active': i === 0 }]} data-filter={c}>{c}</button>
        ))}
      </div>
      <div class="grid">
        {projects.map((p, i) => (
          <div class="grid__item" data-category={p.category}>
            <ProjectCard project={p} index={i} ratio={i % 3 === 0 ? '4 / 5' : '1 / 1'} />
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('.grid__item');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.toggle('is-active', b === btn));
      const f = btn.dataset.filter;
      items.forEach((it) => {
        it.hidden = f !== 'All' && it.dataset.category !== f;
      });
      window.dispatchEvent(new Event('resize'));
    }),
  );
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: clamp(40px, 6vw, 72px);
  }
  .filter {
    background: none;
    color: var(--fg);
    font: inherit;
    font-size: 15px;
    padding: 10px 22px;
    border-radius: 999px;
    border: 1px solid var(--line);
    cursor: pointer;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }
  .filter:hover,
  .filter.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-fg);
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 80px) clamp(24px, 3vw, 48px);
    align-items: start;
  }
  .grid__item:nth-child(even) {
    margin-top: clamp(0px, 10vw, 160px);
  }
  .grid__item[hidden] {
    display: none;
  }
  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .grid__item:nth-child(even) {
      margin-top: 0;
    }
  }
</style>
