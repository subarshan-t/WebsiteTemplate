---
import Base from '../../layouts/Base.astro';
import Art from '../../components/Art.astro';
import Arrow from '../../components/Arrow.astro';
import { projects, type Project } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length], index: i },
  }));
}
interface Props {
  project: Project;
  next: Project;
  index: number;
}
const { project, next, index } = Astro.props;
---
<Base title={project.title} description={project.summary}>
  <section class="head">
    <div class="container">
      <a href="/portfolio" class="back link" data-reveal>← All projects</a>
      <h1 class="display" data-split>{project.title}</h1>
      <div class="meta">
        <div data-reveal><span>Client</span>{project.client}</div>
        <div data-reveal data-delay="0.1"><span>Category</span>{project.category}</div>
        <div data-reveal data-delay="0.2"><span>Year</span>{project.year}</div>
        <div data-reveal data-delay="0.3"><span>Services</span>{project.services.join(', ')}</div>
      </div>
    </div>
  </section>

  <div class="container cover" data-reveal>
    <Art hue={project.hue} variant={index} label={project.title} parallax />
  </div>

  <section class="section">
    <div class="container body">
      <h2 class="h3">{project.summary}</h2>
      <div class="body__text">
        {project.body.map((para) => <p data-reveal>{para}</p>)}
      </div>
    </div>
    <div class="container gallery">
      <Art hue={(project.hue + 30) % 360} variant={index + 1} label={`${project.title} detail`} />
      <Art hue={(project.hue + 330) % 360} variant={index + 2} label={`${project.title} detail`} />
    </div>
  </section>

  <a href={`/portfolio/${next.slug}`} class="next" data-cursor="Next">
    <div class="container">
      <span class="eyebrow">Next project</span>
      <div class="next__title">{next.title} <Arrow /></div>
    </div>
  </a>
</Base>

<style>
  .head {
    padding: clamp(150px, 18vw, 220px) 0 clamp(40px, 6vw, 72px);
  }
  .head .container {
    display: grid;
    gap: 32px;
  }
  .back {
    justify-self: start;
    color: var(--muted);
  }
  .meta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .meta span {
    display: block;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .cover :global(.art) {
    --ratio: 16 / 8;
  }
  .body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 100px);
  }
  .body__text {
    display: grid;
    gap: 24px;
    color: var(--muted);
    font-size: 19px;
  }
  .gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: clamp(60px, 8vw, 120px);
  }
  .next {
    display: block;
    background: var(--accent);
    color: var(--accent-fg);
    padding: clamp(60px, 8vw, 120px) 0;
  }
  .next .eyebrow {
    color: inherit;
  }
  .next .eyebrow::before {
    background: var(--accent-fg);
  }
  .next__title {
    display: flex;
    align-items: center;
    gap: 24px;
    font-family: var(--font-condensed);
    text-transform: uppercase;
    font-size: clamp(56px, 10vw, 160px);
    line-height: 1;
    margin-top: 16px;
  }
  .next__title :global(svg) {
    width: 0.5em;
    transition: transform 0.4s ease;
  }
  .next:hover .next__title :global(svg) {
    transform: translateX(16px);
  }
  @media (max-width: 800px) {
    .meta,
    .body,
    .gallery {
      grid-template-columns: 1fr 1fr;
    }
    .body {
      grid-template-columns: 1fr;
    }
  }
</style>
