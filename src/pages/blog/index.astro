---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Art from '../../components/Art.astro';
import { posts, formatDate } from '../../data/site';
const [featured, ...rest] = posts;
---
<Base title="Blog" description="Thoughts on design, branding and development from the Redox team.">
  <PageHero eyebrow="Journal" title="News &amp;<br /><em class='accent'>insights</em>" lead="Notes from the studio on design, brand, technology and the craft in between." />

  <section class="section">
    <div class="container">
      <a href={`/blog/${featured.slug}`} class="featured" data-reveal data-cursor="Read">
        <Art hue={featured.hue} variant={1} label={featured.title} parallax />
        <div class="featured__body">
          <div class="meta"><span>{featured.category}</span><span>{formatDate(featured.date)}</span><span>{featured.readTime}</span></div>
          <h2 class="h2">{featured.title}</h2>
          <p class="lead">{featured.excerpt}</p>
        </div>
      </a>
      <div class="list">
        {rest.map((p, i) => (
          <a href={`/blog/${p.slug}`} class="item" data-reveal data-cursor="Read">
            <Art hue={p.hue} variant={i} label={p.title} />
            <div class="meta"><span>{p.category}</span><span>{formatDate(p.date)}</span></div>
            <h3 class="h3">{p.title}</h3>
            <p>{p.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .featured {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    padding-bottom: clamp(60px, 8vw, 100px);
    border-bottom: 1px solid var(--line);
  }
  .featured :global(.art) {
    --ratio: 4 / 3;
  }
  .featured__body {
    display: grid;
    gap: 24px;
  }
  .featured .h2 {
    font-size: clamp(32px, 4vw, 60px);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 14px;
    color: var(--muted);
  }
  .meta span:first-child {
    color: var(--accent);
  }
  .list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px 32px;
    margin-top: clamp(60px, 8vw, 100px);
  }
  .item {
    display: grid;
    gap: 16px;
    align-content: start;
  }
  .item :global(.art) {
    --ratio: 16 / 10;
  }
  .item p {
    color: var(--muted);
  }
  @media (max-width: 800px) {
    .featured,
    .list {
      grid-template-columns: 1fr;
    }
  }
</style>
